{
    "name": "gorontalokota/sso-laravel",
    "description": "Integrasi SSO Pemerintah Kota Gorontalo untuk Laravel: login OIDC siap pakai, back-channel logout, dan guard API bearer token.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sso",
        "oidc",
        "openid-connect",
        "guard",
        "gorontalo"
    ],
    "homepage": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK",
    "support": {
        "issues": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK/issues",
        "source": "https://github.com/Diskominfo-Kota-Gorontalo/SSO-SDK"
    },
    "require": {
        "php": "^8.2",
        "gorontalokota/sso-php": "^0.1",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gorontalokota\\Sso\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gorontalokota\\Sso\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gorontalokota\\Sso\\Laravel\\SsoServiceProvider"
            ],
            "aliases": {
                "Sso": "Gorontalokota\\Sso\\Laravel\\Facades\\Sso"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-core",
            "options": {
                "symlink": true,
                "versions": {
                    "gorontalokota/sso-php": "0.1.0"
                }
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
